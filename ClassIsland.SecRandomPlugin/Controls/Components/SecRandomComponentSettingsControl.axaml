<controls:ComponentBase x:TypeArguments="models:SecRandomComponentSettings"
                        x:Class="ClassIsland.SecRandomPlugin.Controls.Components.SecRandomComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        xmlns:local="clr-namespace:ClassIsland.SecRandomPlugin.Controls.Components"
                        xmlns:models="clr-namespace:ClassIsland.SecRandomPlugin.Models"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        mc:Ignorable="d"
                        d:DesignHeight="300" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:SecRandomComponentSettingsControl}}">
            <fa:SettingsExpander Header="标题文字" Description="显示在组件左侧的标题。">
                <fa:SettingsExpander.Footer>
                    <TextBox Width="200" Text="{Binding Settings.Header, UpdateSourceTrigger=PropertyChanged}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="显示标题" Description="是否显示组件标题。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowHeader}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="空闲提示" Description="尚未抽取时显示的文本。">
                <fa:SettingsExpander.Footer>
                    <TextBox Width="200" Text="{Binding Settings.IdleText, UpdateSourceTrigger=PropertyChanged}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>
