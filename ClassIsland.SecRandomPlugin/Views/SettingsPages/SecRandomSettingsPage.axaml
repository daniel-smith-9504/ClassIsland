<ci:SettingsPageBase x:Class="ClassIsland.SecRandomPlugin.Views.SettingsPages.SecRandomSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     mc:Ignorable="d"
                     d:DesignHeight="760" d:DesignWidth="980">
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="0 0 16 16">
            <TextBlock Text="抽取设置" FontSize="20" FontWeight="SemiBold" Margin="0 8 0 0"/>
            <TextBlock Text="参考 SecRandom 的公平抽取：根据历史抽取次数动态调整权重，减少重复与分布失衡。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

            <fa:SettingsExpander Header="抽取人数" Description="每次点名抽取的学生数量。">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Width="140" Minimum="1" Maximum="50" Value="{Binding Service.Config.DrawCount, Mode=TwoWay}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="抽取方式" Description="公平抽取会优先抽取历史被抽中次数较少的学生。">
                <fa:SettingsExpander.Footer>
                    <ComboBox Width="160" SelectedIndex="{Binding Service.Config.DrawType, Mode=TwoWay}">
                        <ComboBoxItem Content="随机抽取"/>
                        <ComboBoxItem Content="公平抽取"/>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="抽取范围"
                                 Description="限定从全部学生、某个分组、性别或标签中抽取。标签可在下方名单中按学生设置。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ScopeTypeCombo" Width="130"
                                  SelectionChanged="ScopeType_OnSelectionChanged">
                            <ComboBoxItem Content="全部学生"/>
                            <ComboBoxItem Content="按分组"/>
                            <ComboBoxItem Content="按性别"/>
                            <ComboBoxItem Content="按标签"/>
                        </ComboBox>
                        <ComboBox x:Name="ScopeValueCombo" Width="130"
                                  IsVisible="False"
                                  ItemsSource="{Binding ScopeValues}"
                                  SelectionChanged="ScopeValue_OnSelectionChanged"/>
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="重复控制"
                                 Description="允许重复：不做限制；不重复：历史中被抽中过的学生不再参与；半重复：达到上限后不再参与。">
                <fa:SettingsExpander.Footer>
                    <ComboBox Width="160" SelectedIndex="{Binding Service.Config.RepeatMode, Mode=TwoWay}">
                        <ComboBoxItem Content="允许重复"/>
                        <ComboBoxItem Content="不重复"/>
                        <ComboBoxItem Content="半重复"/>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="半重复上限" Description="「半重复」模式下，同一学生被抽中达到此次数后不再参与抽取。">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Width="140" Minimum="1" Maximum="50" Value="{Binding Service.Config.HalfRepeat, Mode=TwoWay}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="全局冷却"
                                 Description="开启后，刚被抽中的学生在指定时间内不会再次被抽中。单个学生可在名单中设置自己的冷却时长。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumericUpDown Width="140" Minimum="1" Maximum="1440"
                                       Value="{Binding Service.Config.ShieldMinutes, Mode=TwoWay}"
                                       IsEnabled="{Binding Service.Config.ShieldEnabled}"/>
                        <ToggleSwitch IsChecked="{Binding Service.Config.ShieldEnabled, Mode=TwoWay}"/>
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <TextBlock Text="学生名单" FontSize="20" FontWeight="SemiBold" Margin="0 16 0 0"/>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="1.4*,1.1*,0.9*,0.9*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="NewNameBox" Watermark="姓名"/>
                        <TextBox x:Name="NewIdBox" Grid.Column="1" Watermark="学号（可选）"/>
                        <TextBox x:Name="NewGroupBox" Grid.Column="2" Watermark="分组（可选）"/>
                        <TextBox x:Name="NewTagBox" Grid.Column="3" Watermark="标签（可选）"/>
                        <Button Grid.Column="4" Content="添加" Click="AddStudent_OnClick"/>
                    </Grid>

                    <ListBox x:Name="StudentList" ItemsSource="{Binding Service.Students}" MaxHeight="380">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,1.3*,1.1*,0.8*,0.7*,0.9*,Auto,Auto" ColumnSpacing="6">
                                    <CheckBox IsChecked="{Binding IsEnabled}" ToolTip.Tip="是否参与抽取"/>
                                    <TextBox Grid.Column="1" Watermark="姓名"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Watermark="学号"
                                             Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Watermark="分组"
                                             Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" Watermark="性别"
                                             Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="5" Watermark="标签"
                                             Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"/>
                                    <NumericUpDown Grid.Column="6" Width="96" Minimum="0" Maximum="1440"
                                                   Value="{Binding CooldownMinutes, Mode=TwoWay}"
                                                   ToolTip.Tip="单独冷却分钟数，0 表示跟随全局冷却"/>
                                    <Button Grid.Column="7" Content="删除" Click="RemoveStudent_OnClick"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="RosterStatusText" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <Expander Header="从 SecRandom 导入" IsExpanded="False">
                        <StackPanel Spacing="8" Margin="0 8 0 0">
                            <TextBlock Text="支持原项目的数据目录、roll_call.srl、*.srhdb、旧版 roll_call_list 档案，以及包含 data 目录的备份 zip。只会读取，不会修改原文件。"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox x:Name="SecRandomPathBox"
                                         Watermark="SecRandom 的 data 目录、.srl / .srhdb 文件或备份 .zip"/>
                                <Button Grid.Column="1" Content="选择文件" Click="PickSecRandomFile_OnClick"/>
                                <Button Grid.Column="2" Content="选择文件夹" Click="PickSecRandomFolder_OnClick"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="扫描档案" Click="ScanSecRandom_OnClick"/>
                                <ComboBox x:Name="SecRandomProfileCombo" Width="300"
                                          ItemsSource="{Binding ImportProfiles}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox x:Name="ImportHistoryCheck" Content="导入抽取历史与次数" IsChecked="True"/>
                                <CheckBox x:Name="ReplaceRosterCheck" Content="导入前清空现有名单" IsChecked="True"/>
                            </StackPanel>
                            <Button Content="开始导入" Click="ImportSecRandom_OnClick" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="SecRandomImportStatusText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="批量导入">
                        <StackPanel Spacing="8" Margin="0 8 0 0">
                            <TextBlock Text="每行一个学生：姓名，或 学号,姓名，或 学号,姓名,分组，或 学号,姓名,分组,标签。"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="ImportBox" AcceptsReturn="True" Height="120" TextWrapping="Wrap"
                                     Watermark="1,张三,第一组,1号"/>
                            <Button Content="导入" Click="Import_OnClick" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>

                    <Button Content="清空名单" Click="ClearRoster_OnClick" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="抽取历史" FontSize="20" FontWeight="SemiBold" Margin="0 16 0 0"/>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="历史记录用于计算公平权重、重复控制与冷却，可在需要时重置。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <ListBox ItemsSource="{Binding Service.History}" MaxHeight="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="立即抽取" Click="Draw_OnClick"/>
                        <Button Content="显示悬浮窗" Click="OpenFloatingWindow_OnClick"
                                ToolTip.Tip="悬浮窗会常驻显示在屏幕上，可拖动标题移动，位置会自动保存"/>
                        <Button Content="清空历史" Click="ClearHistory_OnClick"/>
                    </StackPanel>

                    <TextBlock x:Name="DrawResultText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
